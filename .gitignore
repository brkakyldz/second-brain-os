# Obsidian per-device state
.obsidian/workspace*
.obsidian/graph.json
.obsidian/cache/
.trash/

# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# secret-shaped files — first line of defense
.env
.env.*
*.key
*.pem
*credentials*
*secret*

# automation noise — durable but not vault content
logs/.automation.log*
scripts/.brain.lock

# agent worktrees — never tracked in main
.claude/worktrees/

# machine state lives off the tracked tree (ADR 0032) — derived, per machine
# and rebuild-tolerant. The one live sidecar is the shared daily notice
# counter; the durable half of any record is a ledger line in logs/.
.claude/.maintenance.json
.claude/*.tmp

# retired in v1.1 with the checkpoint, flush and reuse-telemetry hooks (ADR
# 0038, 0039, 0042). Nothing writes these any more; the lines stay so that a
# clone upgraded from v1.0 never commits the leftovers.
.claude/.access.json
.claude/.sessions.json
.claude/.flush-*.lock
scripts/.last-rollup
scripts/.last-push

# the Claude-side view of the one skills copy in .agents/skills/ — a directory
# junction (Windows) or symlink (macOS/Linux) created by `node install.mjs`,
# never a copy and never tracked: it is machine state (ADR 0044)
.claude/skills

# the marker that switches the SessionStart hook on — created by setup, per
# clone, and deliberately never committed, so a fresh clone stays inert until
# it has been personalized (ADR 0014)
core/.vault-active
