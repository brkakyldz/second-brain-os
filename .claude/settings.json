{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs\"", "timeout": 60 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Read|Grep|Glob", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/reuse-telemetry.mjs\"", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/checkpoint.mjs\"", "timeout": 60 } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/checkpoint.mjs\"", "timeout": 60 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-end.mjs\"", "timeout": 30 } ] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/flywheel-metrics.mjs:*)",
      "Bash(node scripts/proposals.mjs:*)",
      "Bash(node scripts/link-sweep.mjs:*)",
      "Bash(node scripts/retrieval-eval.mjs:*)",
      "Bash(node .claude/hooks/maintenance-stamp.mjs:*)",
      "Bash(node .claude/hooks/append-signal.mjs:*)"
    ]
  }
}
